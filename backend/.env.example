# Local development values
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=freight_malawi
DB_SSL=false
# Optional: PEM certificate. Use literal \\n for newlines in a single environment variable.
DB_SSL_CA=
# Use true only when your provider supplies a certificate chain you validate separately.
DB_SSL_REJECT_UNAUTHORIZED=false
DB_CONNECTION_LIMIT=10

# Render supplies PORT automatically. Keep this unset there or use the default below.
PORT=5000
HOST=0.0.0.0
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=7d
# Comma-separated production frontend origins; localhost is useful for local development.
CORS_ORIGIN=http://localhost:5173
