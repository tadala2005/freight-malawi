# Freight Malawi backend environment
NODE_ENV=development
PORT=5000

# Production: postgres + Supabase
DB_CLIENT=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000

# Local MySQL/XAMPP alternative: set DB_CLIENT=mysql and provide DB_* values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=freight_malawi
DB_USER=root
DB_PASSWORD=
DB_SSL=false

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=7d
AUTH_RATE_LIMIT_MAX=

# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
DEVICE_OFFLINE_THRESHOLD_SECONDS=60
